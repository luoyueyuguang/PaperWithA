{
  "name": "paperwitha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p services/core/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/mobile/tsconfig.json",
    "test": "vitest run",
    "dev:core": "corepack pnpm --filter @paperwitha/core dev",
    "dev:web": "corepack pnpm --filter @paperwitha/web dev",
    "start:core": "corepack pnpm --filter @paperwitha/core start",
    "build:web": "corepack pnpm --filter @paperwitha/web build",
    "probe:agent": "corepack pnpm --filter @paperwitha/core smoke"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.2",
    "vite": "6.4.1",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
